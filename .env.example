# ==============================================================================
# WEBZER_SERVICES — Environment Configuration Template
# ==============================================================================

# --- Business Contact Details ---
SITE_URL=https://webzer-services.vercel.app
CONTACT_EMAIL=contact@webzer.com
WHATSAPP_NUMBER=919876543210
INSTAGRAM_HANDLE=@webzer_services

# --- Admin Authentication (Default Demo Credentials) ---
ADMIN_EMAIL=admin@webzer.com
ADMIN_PASSWORD=admin123

# --- Client Portal Demo Account ---
CLIENT_DEMO_EMAIL=client@example.com
CLIENT_DEMO_PASSWORD=client123

# --- Optional Email Integration (e.g., Formspree / EmailJS / Web3Forms) ---
# If using Formspree for contact forms:
# FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# If using Web3Forms (free access key):
# WEB3FORMS_ACCESS_KEY=your_access_key_here

# If using EmailJS:
# EMAILJS_SERVICE_ID=service_xxxxxxx
# EMAILJS_TEMPLATE_ID=template_xxxxxxx
# EMAILJS_PUBLIC_KEY=user_xxxxxxx
